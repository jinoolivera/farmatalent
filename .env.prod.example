# Variables for docker-compose.prod.yml
# Copy to .env.prod on the server and fill in real values

APP_NAME=FarmaTalent
APP_ENV=production
APP_KEY=base64:CHANGE_ME_WITH_php_artisan_key_generate
APP_DEBUG=false
APP_URL=https://farmatalent.pe
APP_HOST=farmatalent.pe
APP_PROTOCOL=https

VIRTUAL_HOST=farmatalent.pe
FRONTEND_URL=https://farmatalent.pe
SANCTUM_STATEFUL_DOMAINS=farmatalent.pe
SESSION_DOMAIN=.farmatalent.pe

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=farmatalent
DB_USERNAME=farmatalent
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_STRONG_ROOT_PASSWORD

CACHE_STORE=database
SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=database

ADMIN_EMAIL=jinooli@gmail.com

# Email (Resend)
MAIL_MAILER=resend
MAIL_HOST=email-smtp.eu-north-1.amazonaws.com
MAIL_PORT=587
MAIL_SCHEME=null
MAIL_ENCRYPTION=tls
MAIL_TIMEOUT=10
MAIL_FROM_ADDRESS=notificaciones@farmatalent.pe
MAIL_FROM_NAME=FarmaTalent
MAIL_REPLY_TO=soporte@farmatalent.pe
MAIL_REPLY_TO_NAME=FarmaTalent
RESEND_KEY=CHANGE_ME_RESEND_API_KEY

AWS_SES_SMTP_ADDRESS=email-smtp.eu-north-1.amazonaws.com
AWS_SES_SMTP_PORT=587
AWS_SES_SMTP_USERNAME=CHANGE_ME_AWS_SES_SMTP_USERNAME
AWS_SES_SMTP_PASSWORD=CHANGE_ME_AWS_SES_SMTP_PASSWORD
